{
  "name": "xrxes",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // the site and the 3D showroom are static (./public); the Worker runs first only for /api/* and /admin
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/admin", "/admin/"] },
  "durable_objects": { "bindings": [{ "name": "LEADS", "class_name": "LeadsDB" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LeadsDB"] }],
  // secrets set in the Cloudflare dashboard: ADMIN_KEY, and optionally RESEND_KEY, MAIL_FROM, NOTIFY_EMAIL
  "keep_vars": true
}
